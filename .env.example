# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN: Optional Upstash Redis for caching & rate-limiting.
# If not provided, CYPHER automatically runs a high-performance in-memory Redis-compatible cache & rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GOOGLE_MAPS_API_KEY / NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key or Maps Demo Key.
# Acquire via https://mapsplatform.google.com/maps-demo-key or Google Cloud Console.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# NEXT_PUBLIC_DEMO_MODE: Set to 'live' for real-time WebRTC camera frames and MediaRecorder streams, or 'demo' for sandbox controls
NEXT_PUBLIC_DEMO_MODE=live
